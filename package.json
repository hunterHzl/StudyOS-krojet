{
  "name": "studyos-android",
  "version": "4.4.0",
  "private": true,
  "description": "StudyOS Android app (Capacitor). Developed by HunterHz.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "setup": "node scripts/setup-android.mjs",
    "sync": "node scripts/build.mjs sync",
    "keystore": "node scripts/keystore.mjs",
    "build:debug": "node scripts/build.mjs debug",
    "build:release": "node scripts/build.mjs release",
    "verify": "node scripts/build.mjs verify",
    "test": "node scripts/test-import-core.mjs && node scripts/test-keystore.mjs && node scripts/test-prepare-web.mjs && node scripts/test-icons.mjs && node scripts/check-secrets.mjs",
    "icons": "python3 tools/generate-icons.py",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0"
  }
}
